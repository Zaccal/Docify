{
  "name": "docify",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.6.7",
      "typescript": "^6",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "sonner": "^2.0.5",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "seed": "bun packages/db/src/seed.ts",
    "db:push": "turbo -F @Docify/db db:push",
    "db:studio": "turbo -F @Docify/db db:studio",
    "db:generate": "turbo -F @Docify/db db:generate",
    "db:migrate": "turbo -F @Docify/db db:migrate",
    "db:migrate:file": "turbo -F @Docify/db db:migrate:file",
    "db:drop": "turbo -F @Docify/db db:drop",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky",
    "cypress:run": "bunx cypress run",
    "cypress:open": "bunx cypress open",
    "e2e:run": "bun ./cypress/runner/scripts/ci.ts",
    "e2e:open": "bun ./cypress/runner/scripts/default.ts"
  },
  "dependencies": {
    "@Docify/env": "workspace:*",
    "dotenv": "catalog:",
    "react-day-picker": "^10.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Docify/config": "workspace:*",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "adm-zip": "^0.6.1",
    "cypress": "^15.21.2",
    "dotenv-cli": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "mammoth": "^1.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.2",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": "bun run lint:fix --",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "bun@1.3.11"
}
